+    if not isinstance(edge, str) or not edge or "/" in edge or "\\" in edge:
+        raise ValueError("cache edge must be a nonempty path-safe string")
+    public_sha = hashlib.sha256(bytes(public_key)).hexdigest()
+    return f"{campaign}-{algorithm}-{edge}-{public_sha[:16]}.cache"
+
