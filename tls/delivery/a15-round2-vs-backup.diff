+def cache_metadata_path(cache_path) -> Path:
+    path = Path(cache_path)
+    return path.with_suffix(path.suffix + ".json")
+
+
+def _fsync_file(path: Path) -> None:
+    with path.open("ab") as stream:
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def _fsync_directory(path: Path) -> None:
+    if os.name == "nt":
+        # Windows has no portable directory fsync; do not claim power-loss
+        # durability for the directory entry.
+        return
+    descriptor = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def write_cache_metadata(cache_path, metadata: dict) -> Path:
+    """Write the sidecar through a unique temporary file and an atomic replace."""
+    target = cache_metadata_path(cache_path)
+    temporary = target.with_name(target.name + ".tmp-" + uuid.uuid4().hex)
+    with temporary.open("xb") as stream:
+        stream.write((json.dumps(metadata, indent=2, sort_keys=True) + "\n").encode("utf-8"))
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(temporary, target)
+    _fsync_directory(target.parent)
+    return target
+
+
